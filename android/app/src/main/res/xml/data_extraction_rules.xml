<?xml version="1.0" encoding="utf-8"?>
<!--
    Reglas de extracción de datos (Android 12+).

    Llavero guarda la bóveda cifrada en la carpeta privada de la app.
    No queremos que ni la copia en la nube ni la transferencia a otro
    dispositivo incluyan esos archivos, así que excluimos todo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
